# Copy to .env and fill in. Nothing here is read at import time except through
# config.Settings, so an unset optional value falls back to the default
# documented in config.py rather than failing at startup.
#
# .env holds a live database password. It is not in version control and must
# not be; there is no repository yet, and when there is, .gitignore has to
# cover this file before the first commit.


# ============================================================ required ======

# Supabase Postgres, session mode (port 5432). Transaction mode (6543) also
# needs prepare_threshold=None in db.py -- psycopg3 auto-prepares after five
# executions and transaction pooling does not support prepared statements.
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres


# ======================================================== generation ========

# Either key enables generation. GEMINI_API is the free tier used for
# embeddings as well; embedding runs are capped at 1,000 requests/day, which
# Ingestion/embed.py works within by keying on content_hash.
GEMINI_API=
OPEN_AI_API=


# ================================================ operator identity =========
#
# Attribution, not access control. See auth.py's docstring: the app connects to
# Postgres as a superuser that bypasses RLS, so the 127.0.0.1 bind is the whole
# of the access control and a cookie does not change that. What this changes is
# whether approved_by / decided_by / validated_by names a person.

# Comma-separated allowlist, written exactly as they should appear in the audit
# columns. An email is the obvious choice -- two approved_by rows already carry
# one from the CLI.
#
# LEAVING THIS EMPTY DISABLES IDENTITY. The UI still works and records
# approvals as 'local-ui', which names nobody; every page then shows a warning
# saying so. That is the pre-auth.py behaviour preserved, not a supported mode.
OPERATORS=automate@renegadeinsurance.com

# Shared secret required at sign-in. Unset means a name can be claimed by
# anyone at the keyboard, and the sign-in page says so plainly rather than
# implying a boundary that is not there.
#
# Set it to raise the floor from "names the person" to "names the person and
# needs the team secret". It does not distinguish people -- shared secrets
# cannot -- so it is a speed bump, not authentication.
# OPERATOR_PASSCODE=

# HMAC key for the identity cookie. Generate a fresh one, never reuse another
# service's:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Unset falls back to a per-process random key, which works and signs everyone
# out on every restart. There is deliberately no default -- a default would
# ship one signing key to every install.
SESSION_SECRET=

# Cookie lifetime in seconds. Default 43200 (12 hours).
# SESSION_MAX_AGE=43200


# ==================================================== tuning (optional) =====
#
# Every value below has a measured or reasoned default in config.py; override
# only with a reason. The two calibrated ones will drift if the corpus changes,
# and both have a script that re-derives them:
#
#   VECTOR_MAX_DISTANCE       scripts/calibrate_retrieval.py
#   NEAR_DUPLICATE_THRESHOLD  scripts/calibrate_dedupe.py
#
# SEARCH_MODE=hybrid
# DEFAULT_TOKEN_BUDGET=6000
# GENERATION_MAX_TOKENS=8000
