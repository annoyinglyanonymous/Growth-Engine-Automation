  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
   {
    "@type": "Question",
    "name": "What is the workers comp rate in Georgia?  ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Georgia&#8217;s worker&#8217;s comp index is $1.64. That means you pay an average of $1.64 for every $100 in payroll. If a person has three employees with a total salary of $100,000, they will pay about $1,640 as worker’s compensation per year. "
    }
   },
   {
    "@type": "Question",
    "name": "Is workers comp insurance required in Georgia? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "By law, all companies with three or more employees, including regular part-time workers, must have worker&#8217;s compensation insurance. "
    }
   },
   {
    "@type": "Question",
    "name": "How to get workers comp insurance in Georgia?  ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "The Georgia Workers Compensation Board does not sell workers compensation insurance. An insurance agent or broker will help you get an affordable and reliable workers comp insurance in Georgia.  "
    }
   },
   {
    "@type": "Question",
    "name": "What is the most expensive workers comp claim?  ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Vehicle accidents are the costliest workplace injuries. On average, a car accident claims costs $81,971 in workers&#8217; compensation costs.   "
    }
   }
  ]
