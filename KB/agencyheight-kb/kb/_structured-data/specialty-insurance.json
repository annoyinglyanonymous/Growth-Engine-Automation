 {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
   {
    "@type": "Question",
    "name": "What is Specialty insurance?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Insurance Risks that are hard-to-place or hard to get coverage for due to high risk nature due to physical hazards, natural calamities, location, huge number of threats involved in the business which are usually unacceptable to the standard markets are categorized under hard-to-place insurance."
    }
   },
   {
    "@type": "Question",
    "name": "What are the examples of industries with hard-to-place insurance risks?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Some of the industries that are considered high risks by carriers are within transportation, healthcare, hospitality, high-value property &amp; home, environmental, retail, technology, artisan &amp; specialty classes areas."
    }
   },
   {
    "@type": "Question",
    "name": "Why some industries are classified as hard-to-place risk industries?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Industries that involve high risks, uncommon coverage needs, high volume of previous claims history, exposed or prone to natural disasters, high crime rates, volatile regulatory or market conditions get classified as hard-to-place insurance risks and often involves working with specialized brokers who can navigate these challenges to find appropriate coverage."
    }
   }
  ]
 }
