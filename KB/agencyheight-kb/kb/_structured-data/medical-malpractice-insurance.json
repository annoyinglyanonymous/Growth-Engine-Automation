  "mainEntity": [
   {
    "@type": "Question",
    "name": "Do I need coverage if my employer provides a policy?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Often yes — employer policies rarely include tail coverage or full license protection."
    }
   },
   {
    "@type": "Question",
    "name": "How much does malpractice insurance cost?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Depends on specialty, state, exposure, and policy type. NP costs may start around $700; surgical specialties can reach $20,000+."
    }
   },
   {
    "@type": "Question",
    "name": "Do I need tail coverage?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "If you have a claims-made policy and you&#8217;re leaving a job or carrier, yes — it’s essential."
    }
   },
   {
    "@type": "Question",
    "name": "What limits should I carry?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Most providers carry $1M/$3M or state-mandated minimums."
    }
   }
