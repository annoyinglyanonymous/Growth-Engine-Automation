  "mainEntity": [
   {
    "@type": "Question",
    "name": "What is a business insurance?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Business liability insurance is designed to protect businesses from financial risks. This insurance protects you and your company from property damage, general liability and also covers employee risks."
    }
   },
   {
    "@type": "Question",
    "name": "Do I need business insurance?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Business insurance protects a business against economic loss due to various risks such as property damage, liability claims, and employee injury. Depending on your industry and the specific risks your business faces, certain types of business insurance may be required by law, while others are strongly recommended to protect your assets and financial stability. You can get a good deal on your business insurance through many insurance companies like Universal North America Insurance. You should further look into other insurance companies to make best decision."
    }
   },
   {
    "@type": "Question",
    "name": "What types of business insurance are there?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "There are several types of business insurance, including general liability insurance, property insurance, commercial auto insurance, workers&#8217; compensation insurance, and professional liability insurance (also known as negligence and omission insurance)."
    }
   }
  ]
