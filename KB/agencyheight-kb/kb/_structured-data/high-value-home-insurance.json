  "mainEntity": [
   {
    "@type": "Question",
    "name": "What is considered high-value home insurance? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Luxury properties that generally exceed $750,000 in replacement costs or $1 million in market valuation require high-value home insurance. "
    }
   },
   {
    "@type": "Question",
    "name": "What is the average cost of high-value home insurance? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "The average annual premium for a property with replacement value of over $750,000 is $4345. However, this cost varies depending on the type of property, valuation, location, and other factors. "
    }
   },
   {
    "@type": "Question",
    "name": "What is an HO-5 policy?  ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "An HO-5 policy is the broadest form of home insurance that one can get. It covers on an open peril basis, meaning unless something is expressly excluded, it should be covered by the policy. "
    }
   }
  ]
