  "@type": "FAQPage",
  "mainEntity": [
   {
    "@type": "Question",
    "name": "What does long-term care insurance cover? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "It covers services like home health care, assisted living, nursing homes, and memory care for chronic illnesses or disabilities. "
    }
   },
   {
    "@type": "Question",
    "name": "When should I buy long-term care insurance? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Ideally in your 50s, when premiums are lower and you&#8217;re more likely to qualify."
    }
   },
   {
    "@type": "Question",
    "name": "Does Medicare cover long-term care? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "No, Medicare only covers short-term skilled care. Long-term custodial care isn’t included. "
    }
   }
  ]
