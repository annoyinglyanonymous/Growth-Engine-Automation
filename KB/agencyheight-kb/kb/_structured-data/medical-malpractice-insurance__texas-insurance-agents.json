   {
    "@type": "Question",
    "name": "2. What is the limit for medical malpractice insurance in Texas? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Texas legislation generally limits the amount of non-economic damages recoverable to $500,000 in wrongful death claims and $250,000 in other claims."
    }
   },
