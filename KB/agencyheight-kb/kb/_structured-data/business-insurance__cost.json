  "mainEntity": [
   {
    "@type": "Question",
    "name": "How much is general liability insurance in GA?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Usually, a small business in Georgia should expect to pay $300 &#8211; $5,000 a year for general liability insurance."
    }
   },
   {
    "@type": "Question",
    "name": "What is general liability insurance for small businesses?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "This policy protects you and your business against personal injury, property damage, defamation, defense of legal proceedings, and financial loss resulting from settlement bonds or judgments."
    }
   },
   {
    "@type": "Question",
    "name": "Why is business insurance expensive? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Commercial insurance protects your business from situations and offers higher limits than personal insurance. For example, a commercial vehicle policy protects assets if a damaged third party sues your business."
    }
   },
   {
    "@type": "Question",
    "name": "How many types of insurance are there for businesses? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "The three important business coverages are general liability, commercial property, and commercial income insurance."
    }
   },
   {
    "@type": "Question",
    "name": "What is commercial umbrella insurance? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Umbrella Commercial Insurance provides additional liability protection by covering costs beyond other liability limits."
    }
   }
  ]
