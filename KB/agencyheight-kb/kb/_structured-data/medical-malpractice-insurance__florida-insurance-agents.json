 {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
   {
    "@type": "Question",
    "name": "1. Does Florida have a medical malpractice cap? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "No, there are no caps on economic damage in Florida. This implies there are no limitations on damages when it comes to settling the compensation with the plaintiff for their medical payments and loss of income due to the medical malpractice. "
    }
   },
   {
    "@type": "Question",
    "name": "2. What doctors pay the most for medical malpractice insurance? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Medical Professionals with riskiest specialties like neurosurgeons, cardiovascular surgeons, obstetricians, surgeons, and ER doctors pay more for medical malpractice insurance. "
    }
   },
   {
    "@type": "Question",
    "name": "3. What are the types of medical malpractice insurance carriers? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "The types of medical malpractice insurance carriers are admitted carriers, excess and surplus lines, risk retention groups, captives, trusts, and joint underwriting associations.    "
    }
   }
  ]
