   {
    "@type": "Question",
    "name": "How much does employer compensation cost?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "A worker&#8217;s compensation costs averaged $41.86 per hour, according to the U.S. Bureau of Labor Statistics."
    }
   },
   {
    "@type": "Question",
    "name": "How much is workers comp insurance Oregon?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "As per 2021 data, Oregon employers will pay employees an average of $1.00 per $100 in payroll. Employee coverage rates vary by insurance company."
    }
   },
   {
    "@type": "Question",
    "name": "How much is workers comp in Washington state?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Looking at rates as a percentage of total payroll, Washington&#8217;s rates declined from 2012 to 2022. If the proposed tax rate increase were to materialize, the average tax rate would be $1.49 per $100 of wages in 2023, It will be about the same in 2021 and 2022."
    }
   },
   {
    "@type": "Question",
    "name": "Do I need workers compensation insurance in Georgia?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "If your Georgia business has three or more people, you must provide them with insurance benefits. If the company is a legal entity or LLC, number of employees should be considered."
    }
   }
