 {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
   {
    "@type": "Question",
    "name": "What is home insurance?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Home insurance protects the infrastructure of your home and the belongings contained inside of it. When you get this insurance, you’ll get coverage for unexpected and accidental damage that can put your house and personal belongings at risk simultaneously."
    }
   },
   {
    "@type": "Question",
    "name": "What does a standard home insurance policy cover?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "A standard home insurance policy protects your house against accidental damage, theft, vandalism, fire, and extreme weather damage such as wind, hail, storm, and fire."
    }
   },
   {
    "@type": "Question",
    "name": "What are some of the exceptions to standard home insurance?",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Your standard home insurance policy does not provide coverage for damage caused by natural disasters such as floods, earthquakes, and hurricanes. It is not provided by the standard policy. The same goes for pets, cars, and houses used as commercial properties. You can contact your agent to get add-ons to your insurance policy if you require coverage for them."
    }
   }
  ]
