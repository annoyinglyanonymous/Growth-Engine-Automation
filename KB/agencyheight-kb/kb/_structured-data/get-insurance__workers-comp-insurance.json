 {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
   {
    "@type": "Question",
    "name": "What is Workers' Compensation? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Workers Compensation Insurance provides health and wage benefits to people who are injured or sick on the job. Workers&#8217; remuneration is considered social insurance because it is based on a social contract between the employer and the employee."
    }
   },
   {
    "@type": "Question",
    "name": "How do I pay for my Workers Compensation policy? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "Your employer pays for workers&#8217; compensation insurance, regardless of which state you are in. An employee&#8217;s compensation cost is a percentage of their payroll."
    }
   },
   {
    "@type": "Question",
    "name": "How much does workers’ compensation insurance cost? ",
    "acceptedAnswer": {
     "@type": "Answer",
     "text": "The average cost of workers&#8217; compensation insurance nationwide is $936 per employee per year, or $78 per month."
    }
   }
  ]
